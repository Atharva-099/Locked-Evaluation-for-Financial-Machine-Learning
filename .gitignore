.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# LICENSED DATA. The shared cache lives at $WRDSLAB_CACHE (default
# ~/.wrdslab/cache), outside every repo. These are a second line of defence.
cache/
*.parquet

# Small aggregate-only dashboard reports are safe to deploy. The exporter
# excludes row-level forecasts, source panels, and fitted models.
!dashboard_data/**/*.parquet

# Large derived artifacts belong in a release, not in git history.
results/**/*.parquet
results/**/*.csv
results/**/*.pkl
results/**/*.npz
results/**/*.joblib
results/**/*.html
results/runs/**/models/

.pgpass
*.pem
*.key
.env
.env.*
secrets.*
.DS_Store

# Local LaTeX build products; source and the final reviewed PDF are staged explicitly.
paper/icml/build/
